# Copy to .env for local runs. On a duplicated Hugging Face Space set these as Secrets / Variables instead.
# Never commit real keys.

# Model provider. anthropic | openai | fake   (fake = scripted offline model, no key needed)
# If unset: anthropic when ANTHROPIC_API_KEY is set, openai when OPENAI_API_KEY is set, else fake.
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# OPENAI_BASE_URL=            # any OpenAI-compatible endpoint
LLM_MODEL=                    # default: claude-opus-5-5 (anthropic) / gpt-4o-mini (openai)
LLM_EFFORT=low                # anthropic only: low|medium|high; blank to omit

# System prompt used when DEFENSE is off: realistic (default; the misconfigured deployment)
# or strict (discount rule marked confidential, no instruction to act on ticket text)
NAIVE_PROMPT=realistic

# Address the poisoned ticket tries to send data to. Reserved .example TLD: cannot belong to anyone.
EXFIL_ADDRESS=records@shopdesk-archive.example

# Optional overrides
# LEVEL=1                     # level selected when the page opens (1-4)
# DEFENSE=false               # DEFENSE checkbox state when the page opens
# MAX_TOKENS=4000
# MAX_ITERATIONS=6
# DB_PATH=/tmp/shopdesk.db
